{
  "realm": "credit-calculator",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "APPLICANT",
        "description": "Credit application applicant"
      },
      {
        "name": "MANAGER",
        "description": "Credit manager who reviews applications"
      },
      {
        "name": "ADMIN",
        "description": "System administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "credit-calculator-app",
      "name": "Credit Calculator Application",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:8080"
      ],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "credit-calculator-api",
      "name": "Credit Calculator API (confidential)",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me-in-production",
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [],
      "defaultClientScopes": [
        "openid",
        "profile",
        "email"
      ]
    }
  ],
  "users": [
    {
      "username": "test-applicant",
      "email": "applicant@example.com",
      "enabled": true,
      "firstName": "Test",
      "lastName": "Applicant",
      "credentials": [
        {
          "type": "password",
          "value": "test-password",
          "temporary": false
        }
      ],
      "realmRoles": ["APPLICANT"]
    },
    {
      "username": "test-manager",
      "email": "manager@example.com",
      "enabled": true,
      "firstName": "Test",
      "lastName": "Manager",
      "credentials": [
        {
          "type": "password",
          "value": "test-password",
          "temporary": false
        }
      ],
      "realmRoles": ["MANAGER"]
    }
  ]
}
